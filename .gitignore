node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Creators' channels are private content, not part of the shared engine.
# Only the bundled example ships; keep your own channel out of the public repo.
# This covers BOTH the per-video content and its media assets.
/channels/*
!/channels/example-explainers/
/public/assets/*
!/public/assets/example-explainers/

# Within the tracked example channel: drop heavy media, keep the folder.
public/assets/**/*.wav
public/assets/**/*.mp3
public/assets/**/*.mp4
public/assets/**/*.mov
!public/assets/**/.gitkeep

# Whisper.cpp install + models (Stage 2) — large, regenerable.
/whisper.cpp
