# Ignore the output video from Git but not videos you import into src/.
out

# Recorded/generated media — large and regenerable. Keep folders, drop heavy files.
public/assets/**/*.wav
public/assets/**/*.mp3
public/assets/**/*.mp4
public/assets/**/*.mov
!public/assets/**/.gitkeep

# Creators' channels are private content, not part of the shared engine.
# Only the bundled example ships; keep your own channel out of the public repo
# (or in a separate private content repo). See docs/brainstorms/voice-driven-pipeline.md.
/channels/*
!/channels/example-explainers/

